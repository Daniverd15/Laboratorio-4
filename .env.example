# Copia a env/<cliente>.env (ignorado por git) y completa. NUNCA subas claves reales.
# Una credencial por dispositivo de IoT Central (Device ID + ID Scope + Primary key):
IOTC_ID_SCOPE=0neXXXXXXXX
IOTC_DEVICE_ID=amqp-lab4
IOTC_DEVICE_KEY=<primary key en base64 del dispositivo>
# Opcional: salta DPS (util en benchmarks). Sin esto cada ejecucion aprovisiona por DPS (HTTPS).
# IOTC_HUB=iotc-xxxxxxxx.azure-devices.net
# Parametros comunes
IOTC_SEND_INTERVAL=5
IOTC_N=0
