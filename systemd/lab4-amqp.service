[Unit]
Description=Lab 4 UNAB-Ambiental - AMQP 1.0 (Proton) hacia IoT Central
After=network-online.target
Wants=network-online.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/lab4
# Credenciales del dispositivo SIN IOTC_HUB (NO versionadas): IOTC_ID_SCOPE, IOTC_DEVICE_ID, IOTC_DEVICE_KEY -> el servicio hace DPS al arrancar
EnvironmentFile=/home/azureuser/lab4/env/amqp.svc.env
Environment=PYTHONUNBUFFERED=1
Environment=IOTC_SEND_INTERVAL=5

ExecStart=/home/azureuser/lab4/.venv/bin/python /home/azureuser/lab4/amqp/amqp_iothub.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
